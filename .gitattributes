# Normalize line endings: store everything as LF in the repo.
# Git auto-detects text files and converts on checkout per the platform.
* text=auto eol=lf

# Explicit binary types — never touch these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.svg   text eol=lf
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.pdf   binary
*.zip   binary
